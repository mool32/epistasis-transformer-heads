__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Large artifacts — store on Drive, not in git
data/eval_sample/*.pt
data/single_scans/*.parquet
data/single_scans/*.npz
data/pair_scans/*.parquet
data/pair_scans/*.npz
# Paper figures ARE tracked (small, reviewer-relevant, frozen with paper draft).
# Ad-hoc / scratch plots can be moved to scratch/ if needed later.
# figures/*.png
# figures/*.pdf

# But keep directory shape
!data/eval_sample/.gitkeep
!data/single_scans/.gitkeep
!data/pair_scans/.gitkeep
!data/analysis/.gitkeep
!figures/.gitkeep

# Phase reports / verdict JSONs / witness CSVs are part of the record.
!data/analysis/**/*.csv
!data/analysis/**/*.json
!data/analysis/**/*.md
!data/analysis/**/*.png
!data/analysis/**/*.parquet
